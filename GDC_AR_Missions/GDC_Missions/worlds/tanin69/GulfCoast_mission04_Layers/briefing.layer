$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "Alors que ça cogne sur Lake Haven Airport et que ça chauffe sur Iona, des enfoirés de spetsnaz ont fait le coup de point la nuit dernière sur notre hub logistique à Sanibel. Avant que nous ayons pu réagir, ils ont été renforcés par l'infanterie de marine russe."\
  ""\
  "Les vilains coupent nos lignes logistiques entre le QG du Battle Group et nos troupes engagées sur Iona et Lake Haven Airport. Il faut réagir vite."\
  ""\
  "La Easy (compagnie d'infanterie légère), bien qu'elle ait subit de lourdes pertes matérielles et humaines, semble disposer d'éléments doués pour mener des actions coup de points, en mode quasi commando."\
  ""\
  "Le platoon Charlie est reformé avec des éléments de Delta pour mener à bien cette nouvelle mission."\
  ""\
  "C'est la dernière chance pour la Easy de redorer son blason."\
  ""
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Fin des années 80. Un archipel tropical dans les caraïbes constitue le poste avancé de l'URSS proche, trop proche des USA."\
  ""\
  "Le gouvernement Etats-Unien décide de lancer une opération militaire pour tenter de contenir la croissance des moyens militaires de ce territoire."\
  ""\
  "L'US Army a pris pied à Gasparilla, à l'extrême sud ouest de l'archipel."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "Reprendre le contrôle de la base militaire de Sanibel."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 d_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "La carte a été corrigée et abondée de renseignements par nos brillants analystes."\
  ""\
  "Il s'agit d'une camp fortifié de la seconde guerre mondiale. L'enceinte extérieure, épaisse de plus d'un mètre, ne pourra pas être breachée avec ce dont vous disposez. Les bunkers de l'enceinte sont abandonnés et inutilisables pour la défense. En revanche, de nombreuses échelles (ladder) permettent d'escalader ces murs."\
  ""\
  "Les positions de nos M2 sont indiquées. On ne sait pas lesquelles seront encore en place après l'attaque des spetsnaz, mais on pense qu'ils ont pu en récupérer tout ou partie."\
  ""\
  "Nous pensons qu'il y a environ 40 pax sur place, mix de spetsnaz et d'infanterie navale."\
  ""\
  "Entre 50 et 60 hostiles sont occupés à miner l'axe routier (infanterie navale et génie/explo). Ils ne resteront sûrement pas inactifs lors de votre attaque."\
  ""\
  "Il s'agit de troupes russes aguerries."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 e_Execution {
  coords 15508.594 52.125 4435.263
  m_sTitle "Exécution"
  m_sTextData "Ne vous faites pas repérer par les troupes à l'extérieur de la base."\
  ""\
  "Le gros des troupes extérieures est probablement occupé à miner (Zulu 2 et Zulu 3), mais on ne peut pas exclure que des observateurs et des patrouilles soient positionnés aux environs immédiats de Zulu 1."\
  ""\
  "Une fois sur la base, vous avez carte blanche."\
  ""\
  "Déclarez la victoire sur le drapeau quand la zone est sous votre contrôle."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
}
