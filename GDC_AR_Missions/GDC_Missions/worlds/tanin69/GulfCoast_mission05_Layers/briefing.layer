$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "La Easy, grâce (ou à cause) de l'action du platoon Charlie sur la reprise de la base militaire de Sanibel, peut remettre 100 balles dans le bastringue. Le commandement de la compagnie leur a royalement accordé une journée ENTIERE de repos."\
  ""\
  "Malheureusement, les russes ont amené des mortiers au nord de la zone Iona. Les copains du secteur Ripley sont salement sous le feu.  Il faut mettre fin à ce pilonnage au plus vite. "\
  ""\
  "Le platoon Charlie est de nouveau sur la brèche (avez-vous écrit à votre femme ?)."\
  ""\
  ""
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Fin des années 80. Un archipel tropical dans les caraïbes constitue le poste avancé de l'URSS proche, trop proche des USA."\
  ""\
  "Le gouvernement Etats-Unien décide de lancer une opération militaire pour tenter de contenir la croissance des moyens militaires de ce territoire."\
  ""\
  "L'US Army a pris pied à Gasparilla, à l'extrême sud ouest de l'archipel."\
  ""\
  "Mais il semble que l'opération <i>Baie des Pochons</i> soit plutôt improvisée... Sûrement la faute aux politichiens !"
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "Localiser et détruire la position d'artillerie."\
  ""\
  "<b>Raid :"\
  ""\
  "Opération de petite ou moyenne envergure avec un objectif très précis (capturer un chef, détruire un pont, libérer des prisonniers…). Cette activité se termine toujours par un retrait planifié une fois l'objectif atteint, sans chercher à tenir le terrain conquis.</b>"\
  ""\
  "<i>la_Vieille, d'après l'OTAN ATP 3.2.1</i>"
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 d_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "<b>Les brillants analystes de la Coy Easy pensent que :</b>"\
  "  - les mortiers se trouvent dans le quadrilatère marqué sur carte"\
  "  - des observateurs d'artillerie (genre BRDM) ont pris des positions avancées pour diriger les tirs de leurs gas (sic)"\
  "  - deux pelotons d'infanterie motorisée sont sur zone, probablement un sur le flanc est et l'autre sur la flanc ouest"\
  "  - il y a probablement quelques patrouilles sur zone"
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 e_Execution {
  coords 15508.594 52.125 4435.263
  m_sTitle "Exécution"
  m_sTextData "<b>Tous les supports sont mobilisés sur d'autres missions. Vous devez faire avec les moyens à votre disposition.</b>"\
  ""\
  "> Départ du carrefour Est de Iona (mythiquement défendu)."\
  ""\
  "> Votre zone d'intervention est délimitée sur carte."\
  ""\
  "> L'est de Iona est interdit pour vous (painted red) car trop de combats sur cette zone. N'y pénétrez pas."\
  ""\
  "> N'engagez les pelotons motorisés russes qu'en cas de nécessité. La charge \"sabre au clair\" ne parait pas la meilleure option... Mais à vous de voir !"\
  ""\
  "> Trouvez et détruisez la position des mortiers. Rendez tout véhicule ou matériel sur place inutilisable."\
  ""\
  "> Une fois votre objectif accompli, tirez-vous de ce merdier et venez rendre compte au QG de la Coy Easy."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
}
