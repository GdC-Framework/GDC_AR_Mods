$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "Après un résultat que l'on peut qualifier de discutable sur la mission précédente, l'étoile du commandant de la compagnie Easy a singuilèrement terni. Nos unités d'infanterie légère ne sont pas de taille (ou pas assez compétentes) pour faire face à des compagnies motorisées russes."\
  ""\
  "Le commandement du Battle Group reprend les choses et main : la Coy Delta \"Outlaws\" du 2nd Light Armored Reconnaissance Battalion, équipée de LAV-25, monte au feu en appui de la Coy Easy."\
  ""\
  "Le platoon Charlie de la Coy Easy (vous) est renforcé par un LAV-25 et un sergent de la Coy Delta \"Outlaws\", placés sous le commandement du Platoon leader de Charlie."\
  ""\
  "<b>Le LAV-25 embarque 60 obus APDST supplémentaires (META : attention, pas d'animation de rechargement, il faut attendre une dizaine de secondes pour reprendre la main sur les commandes).</b>"
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Fin des années 80. Un archipel tropical dans les caraïbes constitue le poste avancé de l'URSS proche, trop proche des USA."\
  ""\
  "Le gouvernement Etats-Unien décide de lancer une opération militaire pour tenter de contenir la croissance des moyens militaires de ce territoire."\
  ""\
  "L'US Army a pris pied à Gasparilla, à l'extrême sud ouest de l'archipel."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "Votre objectif prioritaire reste de neutraliser les défenses anti-aériennes  pour libérer nos hélicos."\
  ""\
  "<b><color name=\"red\">Objectif</color></b>"\
  "Détruire la ZSU-23 \"Shilka\" sur Haven. Si vous en avez les moyens, détruire la ZU-23 sur Lake Haven Airport."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 d_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "Les 24 heures qui ont été nécessaires pour réarticuler notre dispositif ont permis aux russes de se réorganiser."\
  ""\
  "Les positions approximatives et les mouvements présumés des unités sovétiques sont marqués sur carte. En résumé :"\
  "- Les 3 platoons survivants de la Coy 2 russe poussent sur toute la largeur de la zone"\
  "- La Shilka s'est mise en protection sur Haven, protégée par 2 platoons de la Coy 3 venus de Lake Haven Airport."\
  "- Lake Haven Airport est protégé par 2 platoons de la Coy 3 et les unités du QG du bataillon sovétique."\
  ""\
  "Mauvaise nouvelle : une reconnaissance aérienne de haute altitude nous a permis d'identifier une ZU-23 sur l'aéroport de Haven."\
  ""\
  "<b><color name=\"orange\">Météo</b></color>"\
  "Temps pluvieux. L'évolution de la météo est incertaine."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 e_Execution {
  coords 15508.594 52.125 4435.263
  m_sTitle "Exécution"
  m_sTextData "> Vous êtes positionnés sur Navajo 2. Votre zone d'intervention est délimitée sur carte."\
  ""\
  "> Vous pouvez être accrochés par les platoons 1 et 2 de la Coy 2. Percez  ou contournez ces unités, inutile de vous user sur cette phase."\
  ""\
  "> Poussez sur Haven pour détruire la ZSU-23."\
  "Si vous décidez de vous arrêter là, sécurisez Haven, puis allez arracher le drapeau soviétique à côté de l'église (victoire mineure)."\
  ""\
  "> Si vous poursuivez : détruisez la ZU-23 sur Lake Haven Airport."\
  "Dès que la ZU-23 est détuite, repliez-vous sur Haven et allez déraciner le drapeau soviétique à côté de l'église (victoire majeure)."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 f_Intel2 {
  coords 10956.793 18.97 2844.508
  m_sTitle "Nouveaux renseignements"
  m_sTextData "<i>Reco aérienne haute altitude datant de 30 minutes</i>"\
  ""\
  "<b><color name=\"red\">Mise à jour des renseignements sur Lake Haven Airport</color></b>"\
  ""\
  "- 4 BTR au nord de l'aéroport"\
  "- 1 BTR au sud"\
  "=> les positions sont marquées sur carte"\
  ""\
  "Pas d'information sur la localisation des troupes à pied. Nos analystes pensent qu'il y a environ 60 PAX sur zone."
  m_aVisibleForFactions {
   "NONE"
  }
  m_iOrder 5
 }
}
