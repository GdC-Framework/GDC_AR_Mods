$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "La Coy Easy, en particulier le Plt Alpha, a fait un bon travail de défense. Nous avons désormais installé une solide position sur Iona et ses alentours."\
  ""\
  "Les russes se sont cassés les dents sur notre défense et sont en train de se replier. Il faut profiter de leur potentielle désorganisation des forces soviétiques pour pousser notre avantage."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Fin des années 80. Un archipel tropical dans les caraïbes constitue le poste avancé de l'URSS proche, trop proche des USA."\
  ""\
  "Le gouvernement Etats-Unien décide de lancer une opération militaire pour tenter de contenir la croissance des moyens militaires de ce territoire."\
  ""\
  "L'US Army a pris pied à Gasparilla, à l'extrême sud ouest de l'archipel."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "Collecter des renseignements sur les positions hostiles. Une fois ces renseignements récupérés, le QG vous avisera de la suite de la mission."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 e_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "<b><color name=\"red\">Météo</b></color>"\
  "Temps est partiellement couvert. L'évolution de la météo est incertaine."\
  ""\
  "<b><color name=\"red\">Volume hostile</b></color>"\
  "Le QG de la compagnie hostile dispose de 2 BTR et de 2 BMP-1. Il y a une trentaine d'hommes sur zone."\
  ""
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 f_Nouvelle_Mission {
  coords 15514.452 52.125 4437.883
  m_sTitle "Nouvelle mission"
  m_sTextData "<b><color name=\"green\">Nouvel objectif</color></b>"\
  "Détruisez la ZSU-23 et désengagez-vous dès que c'est fait. Revenez au QG sur Iona avec tous vos hommes."\
  ""\
  "<b><color name=\"green\">Intels</color></b>"\
  "Il y a une compagnie motorisée ENI avec le QG de bataillon sur l'aéroport. Vous ne tiendrez pas dans la durée face à une compagnie entière."\
  ""\
  "<b>Fin de mission</b>"\
  ""\
  "Revenez au QG de compagnie sur Iona. Pour déclarer la victoire, dans tous les cas, la ZSU-23 doit être détruite."\
  ""\
  "<color name=\"green\">Victoire</color>"\
  "Saluez fièrement l'Union Jack."\
  ""\
  "<color name=\"red\">Défaite</color>"\
  "Expliquez-vous au commandant de la compagnie."\
  ""
  m_iOrder 5
 }
 d_Execution {
  coords 15508.594 52.125 4435.263
  m_sTitle "Exécution"
  m_sTextData "> Vous êtes positionnés à la sortie Est de Iona. Votre zone d'intervention est délimitée sur carte."\
  ""\
  "> Le secteur est sécurisé jusqu'à Navajo 2"\
  ""\
  "> Nous avons localisé les positions possibles du QG de la compagnie qui nous a attaqué."\
  ""\
  "> Neutralisez les éléments du QG et récupérez les renseignements."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
}
