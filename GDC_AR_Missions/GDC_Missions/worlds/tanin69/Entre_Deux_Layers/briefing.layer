 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Eté 2027. Le président D.T. aka \"TACO\" décide d'envoyer des troupes chatouiller son grand ami V.P. Rien que pour de rire."\
  ""\
  "L'idée du commandement des MARSOC est de se sortir de ce merdier en y laissant le moins de plumes possible..."\
  ""\
  "... Quand bien même le Président a dit \"Nos gars sont invincibles, on va vous foutre la paté\""
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "Détruire le transfo au pied de la tour radio"
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 e_Execution {
  coords 8571.886 14.125 3856.151
  m_sTitle "Exécution"
  m_sTextData "Faites au mieux, D.T. vous fait confiance."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 d_Intel {
  coords 5887.263 241.077 7351.6
  m_sTitle "Renseignements"
  m_sTextData "Y'en a partout, mais on sait pas où."\
  ""\
  "Quelques blindés par ci par là."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
}
