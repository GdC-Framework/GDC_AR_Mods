$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 Z_Intel {
  coords 866.198 159.365 1893.564
  m_sTitle "Intel"
  m_sTextData "Il y a plein d'hommes mal rasés - voire barbus -  plus ou moins armés, partout."\
  ""\
  "Ils ont des amis : les petits hommes verts. Ces derniers sortent rarement sans leurs blindés et leurs hélicos."\
  ""\
  "Parfois, tous ces joyeux lurons aiment bien tirer des feux d'artifice de cal. 80 environ."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 B_Situation {
  coords 866.356 159.357 1893.607
  m_sTitle "Situation"
  m_sTextData "Les Marines se sont fait torcher comme des merdes lors de leur dernière sortie du camp de Babaorum."\
  ""\
  "Votre unité se retrouve complètement isolée après le \"repli stratégique\" de vos frères d'armes. En réalité, ça a été une totale débandade !"\
  ""\
  "Avec nos JLTV lourdement armés, on devrait arriver à passer. Mais... Fuel, munitions et matériel médical au plus bas, plus de communication avec Baba... En gros : c'est la merde ! "\
  ""\
  "Et avec ces putains de JLTV qui pompent du diesel comme la mère de Polo fume des clopes, ça n'arrange rien (consommation des véhicules augmentée : surveillez votre jauge de carburant)."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 A_Contexte {
  coords 866.332 159.364 1893.505
  m_sTitle "Contexte"
  m_sTextData "TACO montre ses gros muscles."\
  ""\
  "\"On va leur mettre la patée à ses dégénérés d'Iraliniens*. Leur pétrole sera à nous dans 24 heures\"."\
  ""\
  "*TACO n'est pas très fort ni en géographie, ni en costume, ni en orthographe."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 C_Mission {
  coords 866.398 159.357 1893.597
  m_sTitle "Mission"
  m_sTextData "RTB : Return To Babaorum, c'est votre priorité."\
  ""\
  "Vous aurez besoin de prendre de l'essence et des munitions au passage."\
  ""\
  "En bons Marines, vous ne laisserez aucun matériel sur place (détruire tout matériel qui ne peut pas être emporté avec vous, y compris ce qui est trouvé sur le terrain)."\
  ""\
  "Vous n'utiliserez le matériel ennemi qu'en dernier recours et uniquement avec l'autorisation de votre chef, parce que vous êtes de fiers Marines."\
  ""\
  "Ah, j'oubliais : si tu peux acheter une baguette avant de rentrer à la maison, je pourrais faire des sandouiches au paté de foie."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
}
