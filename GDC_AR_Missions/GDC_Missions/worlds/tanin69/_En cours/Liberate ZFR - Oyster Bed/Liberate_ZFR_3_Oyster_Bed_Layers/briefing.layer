$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "Depuis quelques semaines, avec l'aide de la population, nous nous sommes installés clandestinement au coeur d'Andruhanov, dans le quartier Saint-Pierre. Notre base avancée nous permet de mener des actions de harcèlement contre l'armée de la RPZ dans la capitale de Zimnitrita Est."\
  ""\
  "Malheureusement, nous avons fini par être \"logés\" par les hostiles. Nous avons prévenu les habitants qui ont discrètement déserté le quartier la nuit dernière pour nous laisser le champ libre."\
  ""\
  "L'armée de la RPZ est en train de poser une nasse autour du quartier. En clair : nous sommes en passe d'être encerclés. Il n'est plus possible de fuir purement et simplement."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Zimnitrita, début des années 80."\
  ""\
  "Depuis les années 60, notre fier pays est coupé en deux."\
  ""\
  "A l'ouest de la rivière Drawna, la population s'est libérée du joug soviétique... Avec l'aide de leurs amis occidentaux. La République Fédérale de Zimnitrita (RFZ) est née. Malheureusement, la RFZ, à cause d'un lobbying intense du bloc soviétique et de ses alliés, n'est pas encore reconnue par les Nations Unies."\
  ""\
  "A l'est, la République du Peuple de Zimnitrita (RPZ) est sous perfusion de l'URSS et ne tient que grâce à son soutien."\
  ""\
  "Chaque camp espère réunifier Zimnitrita."\
  ""\
  "Quels moyens recevront les parties de leurs soutiens externes ? Quel camp sera le plus malin ? Le plus adroit dans ses opérations militaires ? Le plus pervers dans la diplomacie ? Et qui fait les meilleurs grillades ?"\
  ""\
  "Seule votre compétence permettra d'apporter des réponses à ces nombreuses questions : le destin de Zimnitrita est entre vos mains !"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 d_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "<b>Objectif</b>"\
  "Résister à l'assaut et s'échapper de la ville vers l'un des trois points d'exfiltration."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 e_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "Assaut :"\
  "On pense que l'assaut sera donné dans 10 minutes. Nous pensons qu'il sera mené par une trentaine d'hommes appuyés par un BTR."\
  ""\
  "Evasion :"\
  "> Les grands axes, carrefours et points névralgiques de la ville sont bien gardés (voir les points d'exclamation sur la carte)."\
  ">Quelques patrouilles à pied ou véhiculées quadrillent Andruhanov."\
  ""\
  "Météo :"\
  "Temps pluvieux, évolution incertaine"\
  ""\
  ""\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 c_CommanderWord {
  coords 15499.244 52.124 4467.599
  m_sTitle "Mot du commandant"
  m_sTextData "Ne tentez aucune sortie avant d'avoir usé l'assaut, sans quoi, ils vont tailleront en pièce dès que vous mettrez le nez en dehors du quartier."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 f_Insert_Extract {
  coords 15495.137 52.124 4449.113
  m_sTitle "Insertion et Extraction"
  m_sTextData "<b><color name=\"green\">Insertion</b></color>"\
  "Vous êtes sur le mignon et petit quartier Saint-Pierre."\
  ""\
  "<b><color name=\"green\">Exfiltration</b></color>"\
  "Des véhicules chargés avec des munitions et du matériel médical vous attendent sur les points \"Extraction\". Vous y serez <i>grosso modo</i> hors de danger."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 5
 }
 g_Hide {
  coords 13264.642 44.532 10175.505
  m_sTitle "Se mettre en sécurité"
  m_sTextData "On vous a déposé des véhicules avec du matos. Vous pouvez faire une pause si vous êtes vraiment épuisés, personne ne vous le reprochera (fin de mission)."\
  ""\
  "Mais il serait plus prudent de dégager de là pour vous rendre sur la cache (marquée sur carte). Ramenez tous les véhicules, nous n'avons pas les moyens de sacrifier du matériel."\
  ""\
  "Souvenez-vous que vous êtes en territoire ennemi."\
  ""
  m_iOrder 6
 }
}
