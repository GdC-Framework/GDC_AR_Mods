$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "Gruwice est le foyer de l'invasion des vilains. Il faut tuer le virus dans l'oeuf."\
  ""\
  "Nous partons de notre base sur l'aéroport international de Zimnitrita. "\
  ""\
  "Nous avons posé une batterie de mortiers prête à nous dérouler le tapis rouge vers l'objectif."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Zimnitrita Est, années 2000. La \"belle contrée\" est toujours ravagée par les conflits."\
  ""\
  "Une milice armée par les forces occultes occidentales tient Gruwice."\
  ""\
  "Nous, gentils soldats de la Fédération de Rouchie devons intervenir pour remettre de l'ordre sur la zone. "\
  ""\
  "Na zdorovia !"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "<b>Objectif</b>"\
  "- Couper la tête du serpent (ie neutraliser tout hostile dans le centre de Gruwice)."\
  "- Faire parler l'oracle (ie récupérer les intels dans le rdc de l'hôtel Météor)."\
  "- Si nécessaire, passer l'aspirateur (ie nettoyer les étages de l'hôtel)"\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 f_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "<b>Topo</b>"\
  ""\
  "> Un canal ceinture entièrement Gruwice. Les trois-quarts (Nord, Est et Sud) sont bétonnés. Le passage à pied n'est possible que par les ponts, passerelles et échelles marqués sur carte. Le reste du canal est bordé de rives escarpées, pratiquables par des soldats bien entrainés."\
  ""\
  "> Au nord, se situe une zone humide. Elle est pratiquable à pied en cette saison."\
  ""\
  "<b>Positions probables</b>"\
  ""\
  "> Attendez-vous à des positions renforcées sur la périphérie. Les mecs ont récupéré quelques armes lourdes soviétiques."\
  ""\
  "> Les immeubles et autres positions de tir favorables sont probablement exploitées."\
  ""\
  "> Sur la place Lénine, seul l'hôtel Météor est occupé."\
  ""\
  "<b>Equipement et volume des hostiles</b>"\
  ""\
  "> Les civils ont fui la zone."\
  ""\
  "> Il s'agit une milice paramilitaire équipée d'armement léger, ils sont très mobiles. Plusieurs véhicules légers armés ont été identifiés."\
  ""\
  "> Pour le moment, il y a au moins une centaine de pax sur place, mais des renforts continuent à débarquer par le sud."\
  ""\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 5
 }
 e_Arty {
  coords 15499.244 52.124 4467.599
  m_sTitle "Support artillerie"
  m_sTextData "L'appuin feu est utilisable par le porteur de la radio R187 (Cdo)"\
  ""\
  "5 missions d'appui feu avec 30 obus maximum sur chaque mission."\
  ""\
  "Entre chaque mission, les mecs auront besoin de recharger les muns et de fumer une clope : cooldown de 5 minutes."\
  ""\
  "La place Lénine est une no-fire zone. Elle est identifiée sur carte par un rectangle orange."\
  ""\
  "Comme le CdO est un débutant, il a le droit à un support type arcade :"\
  ""\
  "1) Faites un clic droit sur la position que vous voulez faire bombarder."\
  "2) Dans le menu radial, choisissez le support artillerie."\
  "3) Réglez les options dans le panneau de commande qui s'ouvre, confirmez ou annulez..."\
  ""\
  "Et davai !"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 d_Insert_Extract {
  coords 15495.137 52.124 4449.113
  m_sTitle "Insertion et Extraction"
  m_sTextData "<color name=\"green\"><b>Insertion</b></color>"\
  ""\
  "Trois points d'insertion possibles :"\
  "- Rouge / Groza"\
  "- Bleu / Kassatka"\
  "- Vert / Sokol"\
  ""\
  "Choisissez le drapeau en fonction des ordres du CdO."\
  ""\
  "<color name=\"green\"><b>Exfiltration</b></color>"\
  "TODO"\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
}
