$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "Gruwice est le foyer de l'invasion des vilains. Il faut tuer le virus dans l'oeuf."\
  ""\
  "Nous partons de notre base sur l'aéroport international de Zimnitrita."\
  ""\
  "Nous avons posé une batterie de mortiers prête à nous dérouler le tapis rouge vers l'objectif."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<i>Zimnitrita Est, années 2000. La \"belle contrée\" est toujours ravagée par les conflits.</i>"\
  ""\
  "<i>Une milice armée par les forces occultes occidentales tient Gruwice.</i>"\
  ""\
  "<i>Nous, gentils soldats de la Fédération de Rouchie devons intervenir pour remettre de l'ordre sur la zone.</i>"\
  ""\
  "<i>Na zdorovia !</i>"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "<color name=\"green\"><b>Objectifs</b></color>"\
  ""\
  "- <b>Couper la tête du serpent</b> : neutraliser tout hostile dans le centre de Gruwice."\
  "- <b>Faire parler l'oracle</b> : récupérer les intels au rdc de l'hôtel Météor."\
  ""\
  "<color name=\"green\"><b>Si nécessaire</b></color>"\
  ""\
  "- <b>Passer l'aspirateur</b> : nettoyer les étages de l'hôtel."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 d_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "<color name=\"green\"><b>Topo</b></color>"\
  ""\
  "- <b>Canal</b> : ceinture entièrement Gruwice."\
  "- <b>Nord, Est, Sud</b> : canal bétonné, passage à pied uniquement par les ponts, passerelles et échelles marqués sur carte."\
  "- <b>Ouest</b> : rives escarpées, praticables par des soldats bien entraînés."\
  "- <b>Au nord du canal</b> : zone humide, praticable à pied en cette saison."\
  ""\
  "<color name=\"green\"><b>Hostiles</b></color>"\
  ""\
  "- <b>Volume</b> : au moins une centaine de pax, renforts en cours par le sud."\
  "- <b>Équipement</b> : milice paramilitaire très mobile, armement léger, plusieurs véhicules légers armés."\
  "- <b>Civils</b> : ont fui la zone."\
  ""\
  "<color name=\"green\"><b>Positions probables</b></color>"\
  ""\
  "- <b>Périphérie</b> : positions renforcées, quelques armes lourdes soviétiques."\
  "- <b>Immeubles et positions de tir favorables</b> : probablement exploités."\
  "- <b>Place Lénine</b> : seul l'hôtel Météor est occupé."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 f_Arty {
  coords 15499.244 52.124 4467.599
  m_sTitle "Support artillerie"
  m_sTextData "<color name=\"green\"><b>Dotation</b></color>"\
  ""\
  "- <b>Accès</b> pour le porteur de la radio R168 (CdO)."\
  "- <b>5 Missions</b> avec 30 obus maximum par mission."\
  "- <b>Cooldown de 5 minutes</b> entre deux missions : les mecs rechargent les muns et fument une clope."\
  "- <b>No-fire zone</b> sur la place Lénine, rectangle orange sur carte."\
  ""\
  "<color name=\"green\"><b>Mode d'emploi</b></color>"\
  ""\
  "Comme le CdO est un débutant, il a le droit à un support type arcade :"\
  ""\
  "1) Clic droit sur la position à bombarder."\
  "2) Dans le menu radial, choisir le support artillerie."\
  "3) Régler les options dans le panneau, puis confirmer ou annuler."\
  ""\
  "Et davai !"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 5
 }
 e_Insert_Extract {
  coords 15495.137 52.124 4449.113
  m_sTitle "Insertion et Exfiltration"
  m_sTextData "<color name=\"green\"><b>Insertion</b></color>"\
  ""\
  "Trois points d'insertion possibles :"\
  ""\
  "- <color name=\"red\"><b>Rouge / Groza</b></color> : axe nord."\
  "- <color name=\"blue\"><b>Bleu / Kassatka</b></color> : axe ouest."\
  "- <color name=\"green\"><b>Vert / Sokol</b></color> : axe est."\
  ""\
  "Choisissez le drapeau en fonction des ordres du CdO."\
  ""\
  "<color name=\"green\"><b>Exfiltration</b></color>"\
  ""\
  "Sur un des trois points d'insertion."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
}
