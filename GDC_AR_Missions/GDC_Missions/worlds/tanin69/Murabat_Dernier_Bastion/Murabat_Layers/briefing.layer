$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 D_Intel {
  coords 866.198 159.365 1893.564
  m_sTitle "Intel"
  m_sTextData "<i>En recoupant les informations des reconnaissances et celles apportées par les civils ayant fui la zone, voici ce que nous savons :</i>"\
  ""\
  "> AUCUNE présence hostile signalée en dehors de la zone d'opération (ZOP) délimitée sur carte."\
  ""\
  "> Il y aurait environ 120 HOSTILES SUR ZONE, dont approximativement 70 sur Murabat même et le reste réparti sur la ZOP."\
  ""\
  "> Il y aurait au moins 5 BLINDES SUR ZONE, mais on n'a pas réussi à compter le nombre de roues (BRDM ou BTR, voire un mix des deux) ni à les localiser précisément."\
  ""\
  "> Plusieurs POINTS D'INTERET autour de Murabat sont repérés sur carte."\
  ""\
  "> La localisation probable de l'habitation où loge le chef de Muharibu Allah nous a été indiquée (marquée sur carte)."\
  ""\
  "> Certains hostiles sont équipés de déclencheur \"Homme Mort\" (Dead Man Switch), surtout la garde rapprochée de Muharibu Allah."\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
 B_Situation {
  coords 866.356 159.357 1893.607
  m_sTitle "Situation"
  m_sTextData "Les éléments de la \"Brigade Muharibu Allah\" (les <i>guerriers de Dieu</i>) ont été chassés de la majorité du territoire."\
  ""\
  "Ils se sont repliés dans une zone qu'on peut qualifier \"d'accidentée\". C'est un véritable coupe-gorge."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 A_Contexte {
  coords 866.332 159.364 1893.505
  m_sTitle "Contexte"
  m_sTextData "Septembre 2019. Les USA mènent une lutte acharnée contre une guerilla islamique dans un pays du Moyen-Orient."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 C_Mission {
  coords 866.398 159.357 1893.597
  m_sTitle "Mission"
  m_sTextData "Éliminer le chef de la Brigade Muharibu Allah... et tout hostile s'interposant entre votre objectif et vous !"
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 E_Materiel {
  coords 866.282 159.37 1893.438
  m_sTitle "Matériel"
  m_sTextData "<b><color name=\"green\">JLTV</color></b>"\
  ""\
  "Nous sommes équipés des tout nouveaux JLTV qui ont fait la preuve de leur efficacité dans les semaines précédentes."\
  ""\
  "> Peu de visibilité en conduite."\
  ""\
  "> 2 équipés de M2 avec kit de protection contre les armes légères pour le tireur (4 boites de 200 cartouches pour chacun). La M2 est efficace contre les blindés légers et moyens, en particulier si vous touchez la tourelle de tir"\
  ""\
  "> 4 non armés, avec du matériel supplémentaire pour les fantassins."\
  ""\
  "<color name=\"orange\">Résistance au RPG-7 (PG-7VM) : un coup au but peut immobiliser le véhicule et tuer tout ou partie de l'équipage. Deux coups neutralisent véhicule et équipage dans presque tous les cas.</color>"\
  ""
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 F_FinMission {
  coords 866.31 159.362 1893.52
  m_sTitle "Fin de mission"
  m_sTextData "Fin de mission déclarée par le CdO."\
  ""\
  "Utiliser l'action <b>\"Saisir les documents de Muharibu Allah\"</b> (documents sur la table de nuit à l'étage de la turne du méchant)."
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 5
 }
}
