$grp PS_MissionDescription : "{3136BE42592F3B1B}PrefabsEditable/MissionDescription/EditableMissionDescription.et" {
 b_Situation {
  coords 15505.293 52.126 4440.746
  m_sTitle "Situation"
  m_sTextData "Notre compagnie, la Cy Easy, doit interdire la zone autour de la petite ville de Iona pour permettre à notre génie de construire des positions renforcées sur les îlots entourant la zone."\
  ""\
  "Notre section, le section Alpha, est en charge du secteur Ripley."\
  ""\
  "La section Bravo et une partie de la section Charlie sont sur le secteur Navajo."\
  ""\
  "Le reste de la section Charlie et la section Delta sont en réserve sur le secteur Iona où est positionné le QG de compagnie."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 1
 }
 a_Contexte {
  coords 15513.606 52.44 4461.03
  m_sTitle "Contexte"
  m_sTextData "<b><color name=\"green\">NARRATIF</color></b>"\
  ""\
  "Fin des années 80. Un archipel tropical dans les caraïbes constitue le poste avancé de l'URSS proche, trop proche des USA."\
  ""\
  "Le gouvernement Etats-Unien décide de lancer une opération militaire pour tenter de contenir la croissance des moyens militaires de ce territoire."\
  ""\
  "L'US Army a pris pied à Gasparilla, à l'extrême sud ouest de l'archipel."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
 }
 c_Mission {
  coords 15508.526 52.125 4434.998
  m_sTitle "Mission"
  m_sTextData "<b>Interdiction du secteur Ripley</b>"\
  "Neutraliser tout élément hostile pénétrant ou approchant du secteur"\
  ""\
  "<b>Secteur Iona</b>"\
  "Sauf ordre contraire du QG, votre mission est d'interdire le secteur Ripley. Cependant, sur ordre du QG, et uniquement dans ce cas, il peut vous êtes ordonné de vous replier sur le secteur Iona."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 2
 }
 e_Intel {
  coords 15500.642 52.125 4435.646
  m_sTitle "Renseignements"
  m_sTextData "<b><color name=\"red\">Météo</b></color>"\
  "Pour le moment, le temps est beau et dégagé, mais l'évolution de la météo est incertaine."\
  ""\
  "<b><color name=\"red\">Volume hostile</b></color>"\
  "On pense qu'il y a au moins une compagnie motorisée en face : 4 pelotons avec 2 BTR et une vingtaine de pax pour chacun."\
  ""\
  "<b><color name=\"red\">Progression hostile</b></color>"\
  "Les axes d'approche possibles sont marqués par les séries de points Whisky (secteur Ripley) et Zulu (secteur Navajo). Des éléments de reconnaissance avancés devraient nous fournir des informations sur l'avancée des troupes hostiles."\
  ""\
  "<b>On pense que les premiers contacts visuels avec les russes auront lieu une dizaine de minutes après votre arrivée sur le terrain.</b>"
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 4
 }
 f_Conditions_victoire {
  coords 15514.452 52.125 4437.883
  m_sTitle "Fin de mission"
  m_sTextData "<b><color name=\"green\">Victoire</color></b>"\
  "au moins 90% des effectifs russes sont neutralisés. Le QG vous préviendra."\
  ""\
  "<b><color name=\"red\">Défaite</color></b>"\
  "Iona est investie par les russes."
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 5
 }
 d_Execution {
  coords 15508.594 52.125 4435.263
  m_sTitle "Exécution"
  m_sTextData "> Vous êtes à pied d'oeuvre et positionnés sur le secteur Ripley"\
  ""\
  "> Les blindés sont vos cibles prioritaires"\
  ""\
  "> Vous disposez d'un HMMWV armé et d'un autre non armé pour chaque équipe."\
  ""\
  "> Vous avez toute liberté d'exécution pour remplir la mission d'interdiction, sauf ordre explicite du QG."\
  ""\
  ""
  m_aVisibleForFactions {
   "US"
  }
  m_bEmptyFactionVisibility 1
  m_bShowForAnyFaction 1
  m_iOrder 3
 }
}
